{
  "name": "todex-desktop",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "TodeX desktop client for todex-agentd",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "icons:generate": "node ./scripts/generate-app-icons.mjs",
    "check:electron": "node ./scripts/check-electron.mjs",
    "predev": "node ./scripts/check-electron.mjs",
    "dev": "electron-vite dev",
    "dev:demo": "node ./scripts/dev-demo.mjs",
    "build": "electron-vite build",
    "package": "pnpm run build && electron-builder",
    "preview": "electron-vite preview",
    "test:updates": "node --experimental-strip-types --test scripts/update-policy.test.ts scripts/desktop-entry.test.ts scripts/log-redaction.test.ts scripts/shell-policy.test.ts scripts/queued-follow-ups.test.ts scripts/conversation-warm.test.ts scripts/backend-routing.test.ts scripts/permission-fallback.test.ts scripts/git-errors.test.ts scripts/conversation-search.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify/react": "^6.0.2",
    "@internationalized/date": "^3.12.4",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@remixicon/react": "^4.9.0",
    "@tiptap/core": "^3.31.2",
    "@tiptap/extension-link": "^3.31.2",
    "@tiptap/extension-underline": "^3.31.2",
    "@tiptap/extensions": "^3.31.2",
    "@tiptap/pm": "^3.31.2",
    "@tiptap/react": "^3.31.2",
    "@tiptap/starter-kit": "^3.31.2",
    "@tiptap/suggestion": "^3.31.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.11",
    "motion": "^13.1.1",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.10.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
